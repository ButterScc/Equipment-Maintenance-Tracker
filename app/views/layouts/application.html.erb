
<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "Equipment Maintenance Tracker" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>

<body class="bg-light">

  <div class="d-flex">

    <!-- Sidebar -->
    <aside class="bg-dark text-white p-3 vh-100" style="width: 250px; position: fixed;">

      <h5 class="mb-4">Equipment Tracker</h5>

      <hr>

      <p class="text-secondary small">MENU UTAMA</p>

      <%= link_to root_path, class: "nav-link text-white mb-2 d-flex justify-content-between align-items-center" do %>
  <span>Dashboard</span>

  <div class="d-flex gap-1">
    <% if @sidebar_overdue_count.to_i > 0 %>
      <span class="badge bg-danger rounded-pill">
        <%= @sidebar_overdue_count %>
      </span>
    <% end %>

    <% if @sidebar_due_soon_count.to_i > 0 %>
      <span class="badge bg-warning text-dark rounded-pill">
        <%= @sidebar_due_soon_count %>
      </span>
    <% end %>
  </div>
<% end %>

      <%= link_to "Equipment List", equipments_path,
    class: "nav-link text-white mb-2" %>

    <%= link_to "Add Maintenance", new_maintenance_path,
    class: "nav-link text-white mb-2" %>

    <%= link_to "Maintenance History", maintenances_path,
    class: "nav-link text-white mb-2" %>

    <%= link_to "Equipment Monitoring", monitoring_equipments_path,
    class: "nav-link text-white mb-2" %>

  <%= link_to "Maintenance Calendar", calendar_equipments_path,
    class: "nav-link text-white mb-2" %>

  <%= link_to "Maintenance Report", report_maintenances_path,
    class: "nav-link text-white mb-2" %>

      <hr>

      <p class="text-secondary small">SYSTEM</p>
      <span class="text-secondary small">Equipment Management v1.0</span>

    </aside>

    <!-- Main Content -->
    <main class="flex-grow-1" style="margin-left: 250px;">

      <nav class="navbar bg-white shadow-sm px-4">
        <span class="navbar-brand mb-0 h5">Maintenance Management System</span>
        <span class="text-muted">Admin Panel</span>
      </nav>

      <div class="container-fluid p-4">

        
    <% if notice.present? %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
      <i class="bi bi-check-circle-fill me-2"></i>
    <%= notice %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>
  
    <% if alert.present? %>
      <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
      <i class="bi bi-exclamation-triangle-fill me-2"></i>
    <%= alert %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>


        <% if alert.present? %>
          <div class="alert alert-danger">
            <%= alert %>
          </div>
        <% end %>

        <%= yield %>

      </div>

    </main>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
