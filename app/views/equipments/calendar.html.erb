<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2>Maintenance Calendar</h2>
      <p class="text-muted">Jadwal maintenance equipment per bulan</p>
    </div>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body">

      <div class="d-flex justify-content-between align-items-center mb-4">
  <%= link_to "← Sebelumnya",
      calendar_equipments_path(month: (@month - 1.month).strftime("%Y-%m")),
      class: "btn btn-outline-primary" %>

  <div class="text-center">
    <h4 class="mb-2"><%= @month.strftime("%B %Y") %></h4>

    <%= link_to "Today",
        calendar_equipments_path,
        class: "btn btn-sm btn-primary" %>
  </div>

  <%= link_to "Berikutnya →",
      calendar_equipments_path(month: (@month + 1.month).strftime("%Y-%m")),
      class: "btn btn-outline-primary" %>
</div>
      <div class="row text-center fw-bold bg-dark text-white py-2 rounded-top g-0">
        <% %w[Senin Selasa Rabu Kamis Jumat Sabtu Minggu].each do |day| %>
          <div class="col"><%= day %></div>
        <% end %>
      </div>

      <% @calendar_days.each do |week| %>
        <div class="row g-0">
          <% week.each do |day| %>
            <div class="col border p-2"
                 style="min-height: 125px; background: <%= day.month == @month.month ? '#fff' : '#f1f3f5' %>">

              <div class="fw-bold mb-2">
                <%= day.day %>
                <% if day == Date.current %>
                  <span class="badge bg-primary">Hari Ini</span>
                <% end %>
              </div>

              <% @calendar_equipments.select { |e| e.next_maintenance_date == day }.each do |equipment| %>
                <% badge_class = if day < Date.current
                    "bg-danger"
                  elsif day <= 7.days.from_now.to_date
                    "bg-warning text-dark"
                  else
                    "bg-success"
                  end %>

                <%= link_to equipment_path(equipment),
                    class: "d-block badge #{badge_class} text-decoration-none mb-1 text-wrap" do %>
                  <%= equipment.name %>
                <% end %>
              <% end %>

            </div>
          <% end %>
        </div>
      <% end %>

      <div class="mt-3 d-flex flex-wrap gap-3">
        <span><span class="badge bg-danger"> </span> Overdue</span>
        <span><span class="badge bg-warning"> </span> Due Soon</span>
        <span><span class="badge bg-success"> </span> Scheduled</span>
      </div>

    </div>
  </div>
</div>
