<!-- Search and Filter -->
<div class="card shadow-sm border-0 mb-4">
  <div class="card-body">
    <h5 class="fw-bold mb-3">Search & Filter</h5>

    <%= form_with url: equipments_path, method: :get,
        local: true, class: "row g-2" do |form| %>

      <div class="col-md-3">
        <%= form.text_field :search,
            placeholder: "Cari nama, kode, atau lokasi...",
            value: params[:search],
            class: "form-control" %>
      </div>

      <div class="col-md-3">
        <%= form.select :status,
            options_for_select(
              [["Semua Status", ""],
               ["Active", "active"],
               ["Maintenance", "maintenance"],
               ["Broken", "broken"]],
              params[:status]
            ),
            {},
            class: "form-select" %>
      </div>

      <div class="col-md-3">
        <%= form.select :priority,
            options_for_select(
              [["All Priority", ""],
               ["High", "High"],
               ["Medium", "Medium"],
               ["Low", "Low"]],
              params[:priority]
            ),
            {},
            class: "form-select" %>
      </div>

      <div class="col-md-3 d-flex gap-2">
        <%= form.submit "Cari", class: "btn btn-primary" %>

        <%= link_to "Reset", equipments_path,
            class: "btn btn-outline-secondary" %>
      </div>

    <% end %>
  </div>
</div>



<!-- Equipment Table -->
<div class="card shadow-sm border-0">
  <div class="card-body">

    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="fw-bold mb-0">Equipment List</h5>

      <%= link_to "Monitoring",
          monitoring_equipments_path,
          class: "btn btn-outline-primary btn-sm" %>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle">

        <thead class="table-light">
          <tr>
            <th>Nama</th>
            <th>Kode</th>
            <th>Kategori</th>
            <th>Lokasi</th>
            <th>Status</th>
            <th>Priority</th>
            <th>Next Maintenance</th>
            <th>Aksi</th>
          </tr>
        </thead>

        <tbody>
          <% @equipments.each do |equipment| %>
            <tr>
              <td class="fw-semibold">
                <%= equipment.name %>
              </td>

              <td><%= equipment.code %></td>
              <td><%= equipment.category %></td>
              <td><%= equipment.location %></td>

              <!-- Status -->
              <td>
                <% case equipment.status.to_s.downcase %>
                <% when "active" %>
                  <span class="badge bg-success">Active</span>
                <% when "maintenance" %>
                  <span class="badge bg-warning text-dark">Maintenance</span>
                <% when "broken" %>
                  <span class="badge bg-danger">Broken</span>
                <% else %>
                  <span class="badge bg-secondary">
                    <%= equipment.status %>
                  </span>
                <% end %>
              </td>

              <!-- Priority -->
              <td>
                <% case equipment.priority %>
                <% when "High" %>
                  <span class="badge bg-danger">High</span>
                <% when "Medium" %>
                  <span class="badge bg-warning text-dark">Medium</span>
                <% when "Low" %>
                  <span class="badge bg-success">Low</span>
                <% else %>
                  <span class="badge bg-secondary">Not Set</span>
                <% end %>
              </td>

              <!-- Next Maintenance -->
              <td>
                <% if equipment.next_maintenance_date.present? %>
                  <% if equipment.next_maintenance_date < Date.current %>
                    <span class="badge bg-danger">Overdue</span>
                  <% elsif equipment.next_maintenance_date <= 7.days.from_now.to_date %>
                    <span class="badge bg-warning text-dark">Due Soon</span>
                  <% else %>
                    <span class="badge bg-success">Scheduled</span>
                  <% end %>

                  <div class="small text-muted mt-1">
                    <%= equipment.next_maintenance_date.strftime("%d-%m-%Y") %>
                  </div>
                <% else %>
                  <span class="text-muted">Belum dijadwalkan</span>
                <% end %>
              </td>

              <!-- Action -->
              <td>
                <div class="d-flex gap-2">
                  <%= link_to "Detail",
                      equipment_path(equipment),
                      class: "btn btn-sm btn-outline-info" %>

                  <%= link_to "Edit",
                      edit_equipment_path(equipment),
                      class: "btn btn-sm btn-outline-primary" %>

                  <%= button_to "Hapus",
                      equipment_path(equipment),
                      method: :delete,
                      class: "btn btn-sm btn-outline-danger",
                      form: {
                        data: {
                          turbo_confirm: "Yakin ingin menghapus equipment ini?"
                        }
                      } %>
                </div>
              </td>
            </tr>
          <% end %>

          <% if @equipments.empty? %>
            <tr>
              <td colspan="8" class="text-center text-muted py-4">
                Tidak ada equipment ditemukan.
              </td>
            </tr>
          <% end %>
        </tbody>

      </table>
    </div>

    <!-- Pagination -->
    <div class="d-flex justify-content-between align-items-center mt-3">

      <div class="text-muted small">
        Halaman <%= @current_page %> dari <%= @total_pages %>
      </div>

      <nav>
        <ul class="pagination mb-0">

          <li class="page-item <%= 'disabled' if @current_page == 1 %>">
            <%= link_to "Previous",
                equipments_path(
                  page: @current_page - 1,
                  search: params[:search],
                  status: params[:status],
                  priority: params[:priority]
                ),
                class: "page-link" %>
          </li>

          <% (1..@total_pages).each do |page| %>
            <li class="page-item <%= 'active' if page == @current_page %>">
              <%= link_to page,
                  equipments_path(
                    page: page,
                    search: params[:search],
                    status: params[:status],
                    priority: params[:priority]
                  ),
                  class: "page-link" %>
            </li>
          <% end %>

          <li class="page-item <%= 'disabled' if @current_page == @total_pages %>">
            <%= link_to "Next",
                equipments_path(
                  page: @current_page + 1,
                  search: params[:search],
                  status: params[:status],
                  priority: params[:priority]
                ),
                class: "page-link" %>
          </li>

        </ul>
      </nav>
    </div>

  </div>
</div>
