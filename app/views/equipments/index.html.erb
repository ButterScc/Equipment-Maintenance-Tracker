<!-- Dashboard Statistics -->
<h5 class="fw-bold mb-3">Dashboard Overview</h5>

<div class="row g-3 mb-4">

  <div class="col-md-3">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body">
        <p class="text-muted mb-1">Total Equipment</p>
        <h2 class="fw-bold"><%= @total_equipment %></h2>
        <span class="text-primary small">Seluruh equipment</span>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
      <div class="card-body">
        <p class="text-muted mb-1">Active</p>
        <h2 class="fw-bold text-success"><%= @active_equipment %></h2>
        <span class="small text-muted">Equipment aktif</span>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
      <div class="card-body">
        <p class="text-muted mb-1">Maintenance</p>
        <h2 class="fw-bold text-warning"><%= @maintenance_equipment %></h2>
        <span class="small text-muted">Sedang diperbaiki</span>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card shadow-sm border-0 border-start border-danger border-4 h-100">
      <div class="card-body">
        <p class="text-muted mb-1">Broken</p>
        <h2 class="fw-bold text-danger"><%= @broken_equipment %></h2>
        <span class="small text-muted">Equipment rusak</span>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body">
        <p class="text-muted mb-2">Total Status Changes</p>
        <h3 class="fw-bold mb-0"><%= @total_status_changes %></h3>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body">
        <p class="text-muted mb-2">Equipment Pernah Maintenance</p>
        <h3 class="fw-bold mb-0"><%= @equipment_ever_maintained %></h3>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body">
        <p class="text-muted mb-2">Most Maintained Equipment</p>

        <% if @most_maintained_equipment %>
          <h5 class="fw-bold"><%= @most_maintained_equipment.name %></h5>
          <p class="text-muted mb-0">
            <%= @most_maintained_equipment.maintenance_count %>
            kali maintenance
          </p>
        <% else %>
          <p class="text-muted mb-0">Belum ada equipment.</p>
        <% end %>
      </div>
    </div>
  </div>

</div>

<!-- Maintenance Schedule Overview -->
<h5 class="fw-bold mt-4 mb-3">Maintenance Schedule Overview</h5>

<div class="row g-3 mb-4">

  <div class="col-md-4">
    <div class="card shadow-sm border-0 border-start border-danger border-4 h-100">
      <div class="card-body">
        <p class="text-muted mb-1">Overdue Schedule</p>
        <h2 class="fw-bold text-danger">
          <%= @overdue_schedule_count %>
        </h2>
        <span class="small text-muted">Jadwal sudah lewat</span>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
      <div class="card-body">
        <p class="text-muted mb-1">Due Soon</p>
        <h2 class="fw-bold text-warning">
          <%= @due_soon_count %>
        </h2>
        <span class="small text-muted">Dalam 7 hari ke depan</span>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
      <div class="card-body">
        <p class="text-muted mb-1">Scheduled</p>
        <h2 class="fw-bold text-success">
          <%= @scheduled_count %>
        </h2>
        <span class="small text-muted">Jadwal lebih dari 7 hari</span>
      </div>
    </div>
  </div>

</div>


<!-- Maintenance Schedule Alert List -->
<div class="card shadow-sm border-0 mt-4 mb-4">
  <div class="card-header bg-white">
    <h5 class="fw-bold mb-0">Upcoming Maintenance Schedule</h5>
  </div>

  <div class="card-body">
    <% scheduled_equipments = Equipment.where(
      next_maintenance_date: ..7.days.from_now.to_date
    ).where.not(next_maintenance_date: nil)
      .order(:next_maintenance_date) %>

    <% if @upcoming_scheduled_equipments.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Equipment</th>
              <th>Code</th>
              <th>Location</th>
              <th>Schedule Date</th>
              <th>Status</th>
            </tr>
          </thead>

          <tbody>
            <% @upcoming_scheduled_equipments.each do |equipment| %>
              <tr>
                <td><%= equipment.name %></td>
                <td><%= equipment.code %></td>
                <td><%= equipment.location %></td>
                <td>
                  <%= equipment.next_maintenance_date.strftime("%d-%m-%Y") %>
                </td>
                <td>
                  <% if equipment.next_maintenance_date < Date.current %>
                    <span class="badge bg-danger">Overdue</span>
                  <% else %>
                    <span class="badge bg-warning text-dark">Due Soon</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="alert alert-success mb-0">
        Tidak ada jadwal maintenance yang mendesak.
      </div>
    <% end %>
  </div>
</div>


<!-- Monthly Maintenance Statistics -->
<div class="card shadow-sm border-0 mt-4">
  <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h5 class="mb-0">Monthly Maintenance Statistics</h5>

    <%= form_with url: equipments_path, method: :get, local: true do |form| %>
      <%= form.select :period,
          options_for_select([
            ["6 Bulan", "6"],
            ["12 Bulan", "12"],
            ["24 Bulan", "24"]
          ], @chart_period),
          {},
          class: "form-select",
          onchange: "this.form.submit()" %>
    <% end %>
  </div>

  <div class="card-body">
    <canvas id="maintenanceChart"></canvas>
  </div>
</div>

<!-- Equipment Status Distribution -->
<div class="card shadow-sm border-0 mt-4">
  <div class="card-header bg-white">
    <h5 class="mb-0">Equipment Status Distribution</h5>
  </div>

  <div class="card-body">
    <div style="max-width: 400px; margin: auto;">
      <canvas id="statusChart"></canvas>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  document.addEventListener("turbo:load", function() {
    const maintenanceCanvas = document.getElementById("maintenanceChart");

    if (maintenanceCanvas) {
      if (maintenanceCanvas.chartInstance) {
        maintenanceCanvas.chartInstance.destroy();
      }

      maintenanceCanvas.chartInstance = new Chart(maintenanceCanvas, {
        type: "bar",
        data: {
          labels: <%= raw @maintenance_chart_labels.to_json %>,
          datasets: [{
            label: "Total Maintenance",
            data: <%= raw @maintenance_chart_data.to_json %>,
            backgroundColor: "rgba(54, 162, 235, 0.6)",
            borderColor: "rgba(54, 162, 235, 1)",
            borderWidth: 1,
            borderRadius: 5
          }]
        },
        options: {
          responsive: true,
          scales: {
            y: {
              beginAtZero: true,
              ticks: { precision: 0 }
            }
          }
        }
      });
    }

    const statusCanvas = document.getElementById("statusChart");

    if (statusCanvas) {
      if (statusCanvas.chartInstance) {
        statusCanvas.chartInstance.destroy();
      }

      statusCanvas.chartInstance = new Chart(statusCanvas, {
        type: "doughnut",
        data: {
          labels: <%= raw @status_chart_labels.to_json %>,
          datasets: [{
            data: <%= raw @status_chart_data.to_json %>,
            backgroundColor: ["#198754", "#ffc107", "#dc3545"],
            borderWidth: 2
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: { position: "bottom" }
          }
        }
      });
    }
  });
</script>



