<!-- Maintenance Overdue Alert -->
<div class="card shadow-sm border-0 mt-4 mb-4">
  <div class="card-header bg-danger text-white">
    <h5 class="mb-0">
      <i class="bi bi-exclamation-triangle"></i>
      Maintenance Overdue Alert
    </h5>
  </div>

  <div class="card-body">
    <% if @overdue_equipments.any? %>
      <div class="alert alert-warning">
        Ada <strong><%= @overdue_equipments.length %> equipment</strong>
        yang perlu diperiksa karena belum pernah maintenance
        atau sudah lebih dari 90 hari.
      </div>

      <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Equipment</th>
              <th>Code</th>
              <th>Location</th>
              <th>Last Maintenance</th>
              <th>Action</th>
            </tr>
          </thead>

          <tbody>
            <% @overdue_equipments.each do |equipment| %>
              <tr>
                <td><%= equipment.name %></td>
                <td><%= equipment.code %></td>
                <td><%= equipment.location %></td>
                <td>
                  <% if equipment.last_maintenance_date.present? %>
                    <span class="text-danger">
                      <%= equipment.last_maintenance_date.strftime("%d %B %Y") %>
                    </span>
                  <% else %>
                    <span class="badge bg-secondary">Never Maintained</span>
                  <% end %>
                </td>
                <td>
                  <%= link_to "Detail",
                      equipment_path(equipment),
                      class: "btn btn-sm btn-outline-primary" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="alert alert-success mb-0">
        Semua equipment masih dalam kondisi jadwal maintenance yang baik.
      </div>
    <% end %>
  </div>
</div>

